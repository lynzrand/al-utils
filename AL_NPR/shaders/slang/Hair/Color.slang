    r3.xyz = clamp(mad(r6.xyzx, float4(7.0f, 7.0f, 7.0f, 0.0f), float4(0.3f, 0.3f, 0.3f, 0.0f)).xyz, 0.0f.xxx, 1.0f.xxx);
