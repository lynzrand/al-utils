    r53.xyz = r53.www * r53.xyz;
    r53.w = mad(r45.w, 0.55f, 0.45f);
    r46.xyz = r53.www * r53.xyz;
    o0.xyz = r46.xyz + r42.xyz;
    r0.x = min(r1.w, r2.w);
    r0.y = asfloat((GlobalsData[4u].z != 0.0f) ? 4294967295u : 0u);
    r0.z = ddx_coarse(r0.x);
    r0.w = ddy_coarse(r0.x);
    r0.z = abs(r0.wwww).z + abs(r0.zzzz).z;
    r0.w = r0.x + (-0.01f);
    r1.x = mad((-r0.zzzz).x, 0.5f, r0.w);
    r0.z = max(r0.z, 0.0001f);
    r0.z = r1.x / r0.z;
    r0.z = clamp((r0.zzzz + 1.0f.xxxx).z, 0.0f, 1.0f);
    r0.z += (-0.0001f);
    r0.y = (asuint(r0.y) != 0u) ? r0.z : r0.w;
    r0.y = asfloat((r0.y < 0.0f) ? 4294967295u : 0u);
    if (asuint(r0.y) != 0u) discard;
    o0.w = r0.x;
    StageOutput stage_output;
    stage_output.o0 = o0;
    return stage_output;
}
