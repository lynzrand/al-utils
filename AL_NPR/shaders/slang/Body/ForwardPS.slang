float4 readBodyFluid(float2 uv)
{
#ifdef FILTER_BODY_OIL
    return sampleFluidMask(_FluidTex, sampler_FluidTex, uv);
#else
    return _FluidTex.Sample(sampler_FluidTex, uv);
#endif
}

