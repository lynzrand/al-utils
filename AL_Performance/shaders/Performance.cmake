# Replay experiments are opt-in targets. Each switch corresponds to a branch
# in the captured SSAO estimator or map shadow caster.
set(PERFORMANCE_FEATURES "" CACHE STRING "Semicolon-separated SSAO and map shadow experiment defines")
set(ssao_features SKIP_INVALID_SAMPLE SKIP_ZERO_NUMERATOR)
set(shadow_features FAST_AUDITED_MAP_TEXTURES FAST_OPAQUE_PATH FAST_UNIFORM_PATH)
foreach(feature IN LISTS PERFORMANCE_FEATURES)
    if(feature IN_LIST ssao_features)
        list(APPEND ssao_defines "-D${feature}=1")
    elseif(feature IN_LIST shadow_features)
        list(APPEND shadow_defines "-D${feature}=1")
    else()
        message(FATAL_ERROR "Unknown performance shader feature: ${feature}")
    endif()
endforeach()
compile_stage(SsaoDepthNormals "${CMAKE_CURRENT_LIST_DIR}/SsaoDepthNormals.slang" fragment ps_4_0 /O3 ${ssao_defines})
compile_stage(MapShadowCaster "${CMAKE_CURRENT_LIST_DIR}/MapShadowCaster.slang" fragment ps_5_0 /O3 ${shadow_defines})
compile_stage(MapShadowOpaque "${CMAKE_CURRENT_LIST_DIR}/MapShadowCaster.slang" fragment ps_5_0 /O3 -DOPAQUE_CONTROL=1)
foreach(name SsaoDepthNormals MapShadowCaster MapShadowOpaque)
    add_custom_target("${name}" DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/${name}.${SHADER_TARGET}")
endforeach()
add_custom_target(performance DEPENDS SsaoDepthNormals MapShadowCaster MapShadowOpaque)
